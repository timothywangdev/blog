var
map:array[0..101,0..101]of integer;
f:array[0..101,0..101]of integer;
sort:array[1..1000,1..2]of integer;
m,i,j,k,k1,r,c,max:integer;
procedure quicksort(s,r:integer);
var
i,j:integer;
t:array[1..2]of integer;
begin
i:=s;j:=r;
t[1]:=sort[s,1];
t[2]:=sort[s,2];
repeat
while (map[sort[j,1],sort[j,2]]>map[t[1],t[2]])and(i<j)do dec(j);
if(i<j)then
 begin
 sort[i,1]:=sort[j,1];
 sort[i,2]:=sort[j,2]
 end;
while (map[sort[i,1],sort[i,2]]<map[t[1],t[2]])and(i<j)do inc(i);
if(i<j)then
 begin
 sort[j,1]:=sort[i,1];
 sort[j,2]:=sort[i,2]
 end;
until i>=j;
sort[i,1]:=t[1];
sort[i,2]:=t[2];
if (i-1)>s then quicksort(s,i-1);
if (i+1)<r then quicksort(i+1,r)
end;{quicksort}

begin
fillchar(f,sizeof(f),0);
fillchar(map,sizeof(map),0);
max:=0;
readln(r,c);
for i:=1 to r do
 begin
 for j:=1 to c do
  begin
  read(map[i,j]);
  sort[(i-1)*5+j,1]:=i;
  sort[(i-1)*5+j,2]:=j
  end;
 readln
 end;
quicksort(1,r*c);

for k:=r*c-1 downto 1 do
   begin
   m:=0;i:=sort[k,1];j:=sort[k,2];
   if (f[i-1,j]>m)and(map[i,j]<map[sort[k,1],sort[k,2]]) then m:=f[i-1,j];
   if (f[i+1,j]>m)and(map[i,j]<map[sort[k,1],sort[k,2]]) then m:=f[i-1,j];
   if (f[i,j+1]>m)and(map[i,j]<map[sort[k,1],sort[k,2]]) then m:=f[i,j+1];
   if (f[i,j-1]>m)and(map[i,j]<map[sort[k,1],sort[k,2]]) then m:=f[i,j-1];
   f[i,j]:=m+1;
   if f[i,j]>max then max:=f[i,j]
   end;
writeln(max);
end.
