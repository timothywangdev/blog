var
f:array[0..100,0..100,0..100]of longint;
rmb:array[1..100]of integer;
rp:array[1..100]of integer;
time:array[1..100]of integer;
n,m,r,i,j,k:integer;
function min(a,b:longint):longint;
begin
 if a<b then min:=a
 else min:=b
end;
begin
fillchar(f,sizeof(f),0);
fillchar(rmb,sizeof(rmb),0);
fillchar(rp,sizeof(rp),0);
fillchar(time,sizeof(time),0);
readln(n);
for i:=1 to n do
 begin
 readln(rmb[i],rp[i],time[i]);
 f[1,rmb[i],rp[i]]:=time[i]
 end;
readln(m,r);
for i:=2 to n do
 for j:=0 to m do
  for k:=0 to r do
   if (rmb[i]<=j)and(rp[i]<=k)then
   f[i,j,k]:=min(f[i-1,j,k],f[i-1,j-rmb[i],k-rp[i]]+time[i])
   else
   f[i,j,k]:=f[i-1,j,k];
writeln(f[n,m,r]);
end.

