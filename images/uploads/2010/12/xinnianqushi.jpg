var
f:array[0..100000]of boolean;
re:array[0..10000]of integer;
t:array[1..100]of integer;
w:array[1..100]of integer;
tw,n,lw,i,j,k:integer;
duo:boolean;
procedure quicksort(s,e:integer);
var
p,i,j:integer;
begin
i:=s;j:=e;p:=t[s];
repeat
 while (t[j]>=p)and(i<j) do dec(j);
 if i<j then
  begin
  t[i]:=t[j];
  i:=i+1
  end;
 while (t[i]<=p)and(i<j) do inc(i);
 if i<j then
  begin
  t[j]:=t[i];
  dec(j)
  end;
until i>=j;
t[i]:=p;
if (i-1)>s then quicksort(s,i-1);
if (i+1)<e then quicksort(i+1,s)
end;

begin
fillchar(re,sizeof(re),0);
fillchar(f,sizeof(f),false);
fillchar(t,sizeof(t),0);
fillchar(w,sizeof(w),0);
f[0]:=true;
duo:=false;
tw:=0;
readln(lw);
readln(n);
for i:=1 to n do
 begin
 readln(w[i]);
 inc(tw,w[i])
 end;
lw:=tw-lw;
for i:=1 to n do
 for j:=lw downto w[i] do
  begin
  if (j=lw)and(f[j-w[i]])and(f[j])then
    begin
    duo:=true;
    break
    end;
  if (f[j-w[i]])and(not f[j])then
   begin
   f[j]:=true;
   re[j]:=i
   end
  end;
if duo then
 writeln('-1')
else if not f[lw] then
 writeln('0')
else
 begin
 tw:=0;i:=lw;
 while i<>0 do
  begin
  inc(tw);
  t[tw]:=re[i];
  i:=i-w[re[i]]
  end;
  quicksort(1,tw);
for i:=1 to tw do write(t[i],' ')
 end;
end.

