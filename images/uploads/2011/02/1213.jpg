program super(fin,output);
type
fuck=array[1..2,0..2000]of integer;
var
fin:text;
f:array[0..3000]of longint;
re:array[0..2000]of integer;
a:fuck;
i,j,k,n,max,temp:longint;
procedure quicksort(var a:fuck;s,r:integer);
 var
 i,j,t,t1:integer;
 begin
 t:=a[1,s];t1:=a[2,s];
 i:=s;j:=r;
 while i<j do
  begin
  while (a[1,j]>t)and(i<j)do
   dec(j);
  if i<j then
   begin
   a[2,i]:=a[2,j];
   a[1,i]:=a[1,j];
   inc(i)
   end;
  while (a[1,i]<t)and(i<j)do
   inc(i);
  if i<j then
   begin
   a[2,j]:=a[2,i];
   a[1,j]:=a[1,i];
   dec(j)
   end
  end;
 a[1,i]:=t;a[2,i]:=t1;
 if (i-1)>s then
  quicksort(a,s,i-1);
 if (j+1)<r then
  quicksort(a,j+1,r)
end;{quicksort}
begin
assign(fin,'i.txt');
reset(fin);
fillchar(re,sizeof(re),0);
fillchar(f,sizeof(f),0);
readln(fin,n);
for i:=1 to n do
 f[i]:=1;
for i:=1 to n do
 begin
 readln(fin,a[1,i],a[2,i]);
 if a[1,i]<a[2,i] then
  begin
  temp:=a[1,i];
  a[1,i]:=a[2,i];
  a[2,i]:=temp
  end
 end;
 max:=0;
 quicksort(a,1,n);
a[1,0]:=0;
a[2,0]:=0;
 for i:=2 to n do
  for j:=1 to i-1 do
   if (a[2,j]<a[2,i])and(a[1,j]<a[1,i])and(f[j]+1>f[i])then
    begin
    f[i]:=f[j]+1;
    re[i]:=j
    end;
for i:=1 to n do
 if f[i]>max then
  begin
  max:=f[i];
  re[0]:=i
  end;

writeln(max);
close(fin);
end.
