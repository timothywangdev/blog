VAR
f:array[0..20,0..1]of longint;
h:array[1..20]of integer;
used:arrau[1..20]of boolean;
i,j,k,total,maxh,max1,max2,before,a:integer;
ch:char;
s:string;
function maxlong:integer;
var
i,j,max:integer;
begin
for j:=1 to i-1 do
   if (h[j]>h[i]) and (f[j]+1>f[i]) then
    f[i]:=f[j]+1;
for i:=0 to total do
 if f[i]>max then
  max:=f[i];
maxlong:=max
end;{maxlong}
fillchar(h,sizeof(h),0);
total:=0;
before:=0;
readln(s);
for i:=1 to length(s) do
 begin
if(s[i]=',')or(i=1) then
 begin
 if i<>1 then
  before:=i;
 inc(total);
 j:=1;
 for k:=i+1 to length(s) do
  if s[k]=',' then
   break;
 if k<>length(s) then
 for a:=k-before-2 downto 1 do
  j:=j*10
 else
  for a:=k-before-1 downto 1 do
   j:=j*10
 end;
 if s[i]<>',' then begin
  h[total]:=h[total]+j*((ord(s[i]))-ord('0'));
  j:=j div 10
  end
 end;
for i:=1 to total do
 begin
 f[i,0]:=1;
 f[i,,1]:=0
 end;
max1:=maxlong;
while f[i,1]<>0 do
 used[i]:=true

writeln(max)
end.
